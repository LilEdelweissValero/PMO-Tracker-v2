generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  engineType   = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id               Int       @id @default(autoincrement())
  projectId        String    @map("project_id")
  name             String
  priority         String?
  scopeDescription String?   @map("scope_description")
  references       Json      @default("[]")
  initiatedBy      String?   @map("initiated_by")
  requestedByName  String?   @map("requested_by_name")
  requestedByDept  String?   @map("requested_by_dept")
  systemName       String?   @map("system_name")
  specificModule   String?   @map("specific_module")
  systemOwnerName  String?   @map("system_owner_name")
  systemOwnerDept  String?   @map("system_owner_dept")
  requestType      String?   @map("request_type")
  pmOfficer        String?   @map("pm_officer")
  remarks          String?
  signoffStatus    String    @default("not_signed_off") @map("signoff_status")
  archived         Boolean   @default(false)
  sortOrder        Int       @default(0) @map("sort_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workStreams  WorkStream[]
  changeLogs   ChangeLog[]
  projectSystems ProjectSystem[]

  @@index([sortOrder])
  @@map("projects")
}

model ProjectSystem {
  id                  Int      @id @default(autoincrement())
  projectId           Int      @map("project_id")
  systemModuleEntryId Int      @map("system_module_entry_id")
  createdAt           DateTime @default(now()) @map("created_at")

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  systemModuleEntry SystemModuleEntry  @relation(fields: [systemModuleEntryId], references: [id], onDelete: Cascade)

  @@unique([projectId, systemModuleEntryId])
  @@index([projectId])
  @@index([systemModuleEntryId])
  @@map("project_systems")
}

model WorkStream {
  id                Int       @id @default(autoincrement())
  projectId         Int       @map("project_id")
  name              String?
  assignedDeveloper String?   @map("assigned_developer")
  currentBall       String    @default("Project Management Office") @map("current_ball")
  task              String?
  archived          Boolean   @default(false)
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flowStages FlowStage[]
  changeLogs ChangeLog[]

  @@index([projectId])
  @@index([sortOrder])
  @@map("work_streams")
}

model FlowStage {
  id               Int       @id @default(autoincrement())
  workStreamId     Int       @map("work_stream_id")
  name             String
  orderIdx         Int       @map("order_idx")
  plannedDate      DateTime? @map("planned_date")
  completionDate   DateTime? @map("completion_date")
  responsibleGroup String?   @map("responsible_group")
  responsiblePerson String?  @map("responsible_person")
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workStream WorkStream @relation(fields: [workStreamId], references: [id], onDelete: Cascade)

  @@index([workStreamId])
  @@index([orderIdx])
  @@map("flow_stages")
}

model ChangeLog {
  id            Int      @id @default(autoincrement())
  workStreamId  Int?     @map("work_stream_id")
  projectId     Int?     @map("project_id")
  entryType     String   @map("entry_type")
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  note          String?
  changedBy     String?  @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  bumpDate      DateTime? @map("bump_date")

  workStream WorkStream? @relation(fields: [workStreamId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workStreamId])
  @@index([projectId])
  @@index([changedAt])
  @@index([entryType])
  @@map("change_logs")
}

model SystemModuleEntry {
  id                Int      @id @default(autoincrement())
  system            String
  acronym           String?
  module            String?
  developerAssigned String?  @map("developer_assigned")
  systemOwnerName   String?  @map("system_owner_name")
  systemOwnerDept   String?  @map("system_owner_dept")
  archived          Boolean  @default(false)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  projectSystems ProjectSystem[]

  @@index([sortOrder])
  @@map("system_module_entries")
}

model DirectoryDepartment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  details   String?
  archived  Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("directory_departments")
}

model ConfigValue {
  id        Int      @id @default(autoincrement())
  category  String
  value     String
  acronym   String?
  status    String?
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([sortOrder])
  @@map("config_values")
}

model UnitInvolved {
  id        Int      @id @default(autoincrement())
  group     String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@index([sortOrder])
  @@map("unit_involved")
}
